<Window x:Class="SigeDeployer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SigeDeployer.ViewModels"
        xmlns:conv="clr-namespace:SigeDeployer.Converters"
        mc:Ignorable="d"
        Title="Sige Deployer" Height="780" Width="1100"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
        <conv:BoolToStatusIconConverter x:Key="BoolToIcon"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBg"     Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SurfaceBg"     Color="#2A2A3E"/>
        <SolidColorBrush x:Key="PanelBg"       Color="#252535"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#5B9BD5"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentOrange"  Color="#FF8C00"/>
        <SolidColorBrush x:Key="AccentRed"     Color="#F44336"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#3A3A5C"/>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"          Color="#2A2A3E"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"      Color="#E0E0E0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"       Color="#5B9BD5"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"   Color="White"/>
            </Style.Resources>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background"        Value="{StaticResource SurfaceBg}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background"  Value="{StaticResource SurfaceBg}"/>
                        <Setter Property="Padding"     Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Button Style -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="12,6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnBlue"   BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
        </Style>
        <Style x:Key="BtnGreen"  BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
        </Style>
        <Style x:Key="BtnOrange" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
        </Style>
        <Style x:Key="BtnRed"    BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
        </Style>
        <Style x:Key="BtnGray"   BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#555570"/>
        </Style>
        <Style x:Key="BtnSmall"  BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background"  Value="#3A3A5C"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="FontSize"    Value="11"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background"    Value="#1A1A2E"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="CaretBrush"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"    Value="#1A1A2E"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="Height"        Value="30"/>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="0,0,0,2"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource AccentBlue}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>

        <!-- Tab styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="16,8" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#252540"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#20205A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log entry color by level -->
        <DataTemplate x:Key="LogTemplate">
            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="200"/>  <!-- Log -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ HEADER ═══════════════════════ -->
        <Border Grid.Row="0" Background="#16162A" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="22" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SIGE DEPLOYER" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  Gestor de Versiones y Servicios" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EMPRESA:" Foreground="{StaticResource TextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Width="200" ItemsSource="{Binding Companies}"
                              SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="Name" VerticalAlignment="Center"
                              Style="{StaticResource DarkComboBox}"
                              Foreground="Black"/>
                    <Button Content="+ Nueva" Style="{StaticResource BtnBlue}" Margin="8,0,0,0"
                            Command="{Binding AddCompanyCommand}" ToolTip="Agregar empresa"/>
                    <Button Content="Guardar" Style="{StaticResource BtnGreen}" Margin="4,0,0,0"
                            Command="{Binding SaveCompanyCommand}" ToolTip="Guardar configuración de empresa"/>
                    <Button Content="✕ Eliminar" Style="{StaticResource BtnRed}" Margin="4,0,0,0"
                            Command="{Binding DeleteCompanyCommand}" ToolTip="Eliminar empresa seleccionada"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ TABS ═══════════════════════ -->
        <TabControl Grid.Row="1" Margin="12,4,12,0">

        <!-- ═══════════ TAB: SIGE ═══════════ -->
        <TabItem Header="⚙ SIGE">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="0" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Servicios -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBg}"
                    CornerRadius="6" Padding="12">
                <DockPanel>
                    <!-- Header servicios -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="SERVICIOS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="↺" Style="{StaticResource BtnSmall}"
                                    Command="{Binding RefreshStatusCommand}" ToolTip="Actualizar estados"/>
                            <Button Content="+ Servicio" Style="{StaticResource BtnSmall}" Margin="4,0,0,0"
                                    Command="{Binding AddServiceCommand}" ToolTip="Agregar servicio"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator DockPanel.Dock="Top" Background="{StaticResource BorderColor}" Margin="0,0,0,8"/>

                    <!-- Lista de servicios -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServiceEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBg}" CornerRadius="4"
                                            Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <!-- Checkbox + Nombre -->
                                            <CheckBox Grid.Column="0" Grid.Row="0" IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Grid.Row="0"
                                                     Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontWeight="SemiBold" FontSize="12"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                                     ToolTip="Nombre exacto del servicio de Windows"/>

                                            <!-- Indicador de estado + controles -->
                                            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                                        Orientation="Vertical" HorizontalAlignment="Right" Width="30">

                                                <!-- Punto (detenido/ejecutando) o spinner (en transición) -->
                                                <Grid Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,3">
                                                    <Ellipse Width="10" Height="10"
                                                             Fill="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToColor}}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTransitioning, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="13" Foreground="{StaticResource AccentOrange}"
                                                               ToolTip="{Binding StatusText, Mode=OneWay}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Text" Value="⟳"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTransitioning, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- ▶ Iniciar — resaltado (verde) cuando el servicio está parado -->
                                                <Button Padding="4,2" FontSize="10" Margin="0,0,0,2"
                                                        Content="▶"
                                                        Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanStart, Mode=OneWay}"
                                                        ToolTip="{Binding StatusText, Mode=OneWay}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanStart, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Background" Value="#3A4CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- ■ Detener — resaltado (rojo) cuando el servicio está ejecutando -->
                                                <Button Padding="4,2" FontSize="10" Margin="0,0,0,2"
                                                        Content="■"
                                                        Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanStop, Mode=OneWay}"
                                                        ToolTip="{Binding StatusText, Mode=OneWay}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanStop, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Background" Value="#3AF44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- ✕ Eliminar -->
                                                <Button Content="✕" Style="{StaticResource BtnSmall}"
                                                        Command="{Binding DataContext.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="4,2" FontSize="10"
                                                        ToolTip="Quitar de la lista"/>
                                            </StackPanel>

                                            <!-- Ruta destino (editable) -->
                                            <TextBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                                                     Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="10" Foreground="{StaticResource TextSecondary}"
                                                     Margin="18,2,4,0" Padding="4,2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT: Configuración de empresa -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBg}" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACIÓN DE EMPRESA" Style="{StaticResource SectionHeader}"/>
                        <Separator Background="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nombre empresa -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Nombre empresa:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Ruta base versiones -->
                            <Label Grid.Row="2" Grid.Column="0" Content="Ruta versiones:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding SelectedCompany.BasePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Examinar" Style="{StaticResource BtnGray}"
                                    Margin="4,0,0,0" Click="BrowseBasePath_Click"/>

                            <!-- Ruta WinRAR -->
                            <Label Grid.Row="4" Grid.Column="0" Content="Ruta WinRAR:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding SelectedCompany.WinRarPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="Examinar" Style="{StaticResource BtnGray}"
                                    Margin="4,0,0,0" Click="BrowseWinRar_Click"/>

                            <!-- Prefijo RAR -->
                            <Label Grid.Row="6" Grid.Column="0" Content="Prefijo RAR:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.RarPrefix, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Sufijo RAR -->
                            <Label Grid.Row="8" Grid.Column="0" Content="Sufijo RAR:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.RarSuffix, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Timeout servicios -->
                            <Label Grid.Row="10" Grid.Column="0" Content="Timeout stop (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.StopTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Espera desbloqueo -->
                            <Label Grid.Row="12" Grid.Column="0" Content="Espera unlock (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.UnlockWaitSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Espera extracción -->
                            <Label Grid.Row="14" Grid.Column="0" Content="Espera extrac. (s):" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedCompany.ExtractionWaitSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Ayuda formato -->
                        <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ Formato del archivo RAR:" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0">
                                    <Run Text="  {Prefijo}"/>
                                    <Run Text="{Binding Version, FallbackValue='[versión]'}" Foreground="{StaticResource AccentOrange}"/>
                                    <Run Text="{Binding SelectedCompany.RarSuffix, FallbackValue='_0', StringFormat='{}{0}.rar'}" />
                                </TextBlock>
                                <TextBlock Text="  Ejemplo: Sige.ServerWCF_1_0_352_0.rar"
                                           Foreground="{StaticResource TextSecondary}" FontSize="10" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- DEPLOY BAR -->
        <Border Grid.Row="1" Background="#16162A" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,1" Margin="0,4,0,0">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="VERSIÓN:" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16" FontWeight="Bold" Height="34"
                         ToolTip="Número de versión a instalar (ej: 352)"/>

                <Separator Grid.Column="2" Background="{StaticResource BorderColor}" Margin="0,4"/>

                <Button Grid.Column="3" Content="📦  Instalar con RAR"
                        Style="{StaticResource BtnBlue}" FontSize="13" Height="36" Padding="16,6"
                        Command="{Binding InstallWithRarCommand}"
                        ToolTip="Descomprime el .rar y despliega en todos los servicios seleccionados"
                        IsEnabled="{Binding IsIdle, Mode=OneWay}"/>

                <Button Grid.Column="5" Content="⚡  Solo DLLs"
                        Style="{StaticResource BtnOrange}" FontSize="13" Height="36" Padding="16,6"
                        Command="{Binding InstallDllOnlyCommand}"
                        ToolTip="Copia directamente desde la carpeta ya descomprimida (sin RAR)"
                        IsEnabled="{Binding IsIdle, Mode=OneWay}"/>

                <Button Grid.Column="7" Content="✕  Cancelar"
                        Style="{StaticResource BtnRed}" FontSize="13" Height="36" Padding="14,6"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy, Mode=OneWay}"/>

                <!-- Busy indicator -->
                <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳ " Foreground="{StaticResource AccentOrange}" FontSize="16"
                               RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="SpinTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource AccentOrange}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        </TabItem>

        <!-- ═══════════ TAB: POOL GESTOR ═══════════ -->
        <TabItem Header="📦 Pool Gestor">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- POOL MAIN CONTENT -->
        <Grid Grid.Row="0" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Servidores -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBg}"
                    CornerRadius="6" Padding="12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock Text="SERVIDORES" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="+ Servidor" Style="{StaticResource BtnSmall}"
                                Command="{Binding AddPoolServerCommand}" ToolTip="Agregar servidor"/>
                    </DockPanel>

                    <Separator DockPanel.Dock="Top" Background="{StaticResource BorderColor}" Margin="0,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PoolServerEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBg}" CornerRadius="4"
                                            Margin="0,0,0,4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ServerPath, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                                     ToolTip="Ruta UNC del servidor (ej: \\172.31.100.19\c$\Audinfor\SigePool)"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource BtnSmall}"
                                                    Command="{Binding DataContext.RemovePoolServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,2" FontSize="10"
                                                    ToolTip="Quitar de la lista"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- RIGHT: Configuración de pool -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBg}" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CONFIGURACIÓN DE POOL" Style="{StaticResource SectionHeader}"/>
                        <Separator Background="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nombre pool -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Nombre pool:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedPool.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Ejecutable origen -->
                            <Label Grid.Row="2" Grid.Column="0" Content="Exe origen:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding SelectedPool.SourceExePath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ruta del ejecutable nuevo a distribuir"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Examinar" Style="{StaticResource BtnGray}"
                                    Margin="4,0,0,0" Click="BrowsePoolSource_Click"/>

                            <!-- Nombre exe destino -->
                            <Label Grid.Row="4" Grid.Column="0" Content="Nombre exe:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding SelectedPool.ExeName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nombre del ejecutable en los servidores destino"/>
                        </Grid>

                        <!-- Ayuda -->
                        <Border Background="#1A1A2E" CornerRadius="4" Padding="10" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ Proceso de actualización:" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="  1. En cada servidor, el exe actual se renombra como backup: "/>
                                    <Run Text="_[nombre]_[ddMMyyyy].exe" Foreground="{StaticResource AccentOrange}"/>
                                    <LineBreak/>
                                    <Run Text="  2. Se copia el exe nuevo desde la ruta origen."/>
                                    <LineBreak/>
                                    <Run Text="  Solo se procesan los servidores marcados ✓."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- POOL ACTION BAR -->
        <Border Grid.Row="1" Background="#16162A" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,1" Margin="0,4,0,0">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="TIPO POOL:" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Pools}"
                          SelectedItem="{Binding SelectedPool}"
                          DisplayMemberPath="Name" VerticalAlignment="Center"
                          Style="{StaticResource DarkComboBox}" Height="34"
                          Foreground="Black"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="+ Nuevo" Style="{StaticResource BtnSmall}"
                            Command="{Binding AddPoolCommand}" ToolTip="Agregar tipo de pool"/>
                    <Button Content="Guardar" Style="{StaticResource BtnSmall}" Margin="4,0,0,0"
                            Command="{Binding SavePoolCommand}" ToolTip="Guardar configuración del pool"/>
                    <Button Content="✕" Style="{StaticResource BtnSmall}" Margin="4,0,0,0"
                            Command="{Binding DeletePoolCommand}" ToolTip="Eliminar tipo de pool"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="🚀  Actualizar Pool"
                            Style="{StaticResource BtnGreen}" FontSize="13" Height="36" Padding="16,6"
                            Command="{Binding UpdatePoolCommand}"
                            ToolTip="Renombra el exe actual como backup y copia el nuevo en los servidores marcados"
                            IsEnabled="{Binding IsIdle, Mode=OneWay}"/>

                    <Button Content="🧹  Limpiar Backups"
                            Style="{StaticResource BtnOrange}" FontSize="13" Height="36" Padding="16,6" Margin="8,0,0,0"
                            Command="{Binding CleanPoolCommand}"
                            ToolTip="Elimina los .exe de backup (renombrados con fecha) en los servidores marcados"
                            IsEnabled="{Binding IsIdle, Mode=OneWay}"/>
                </StackPanel>

                <Button Grid.Column="6" Content="✕  Cancelar"
                        Style="{StaticResource BtnRed}" FontSize="13" Height="36" Padding="14,6"
                        Command="{Binding CancelCommand}"
                        IsEnabled="{Binding IsBusy, Mode=OneWay}"/>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳ " Foreground="{StaticResource AccentOrange}" FontSize="16"
                               RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="PoolSpinTransform" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PoolSpinTransform"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource AccentOrange}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        </TabItem>

        </TabControl>

        <!-- ═══════════════════════ LOG ═══════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0"
                Margin="12,4,12,4">
            <DockPanel Margin="10,8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock Text="LOG DE OPERACIONES" Style="{StaticResource SectionHeader}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Limpiar" Style="{StaticResource BtnSmall}"
                            Command="{Binding ClearLogCommand}"/>
                </DockPanel>
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                              Background="#12121E" Padding="6">
                    <ItemsControl x:Name="LogList" ItemsSource="{Binding LogEntries}"
                                  ItemTemplate="{StaticResource LogTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════ STATUS BAR ═══════════════════════ -->
        <Border Grid.Row="3" Background="#12121E" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left"
                           Foreground="{StaticResource TextSecondary}" FontSize="10">
                    <Run Text="Empresa: "/>
                    <Run Text="{Binding SelectedCompany.Name, Mode=OneWay, FallbackValue='—'}"
                         Foreground="{StaticResource AccentBlue}"/>
                    <Run Text="  |  Servicios: "/>
                    <Run Text="{Binding ServiceEntries.Count, Mode=OneWay, FallbackValue='0'}"
                         Foreground="{StaticResource AccentBlue}"/>
                    <Run Text="  |  Requiere ejecución como Administrador"/>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
