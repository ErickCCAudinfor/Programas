<!--
    Piezas del formulario de operación: el selector de entorno y el enlace de vuelta.

    El selector es un ListBox y no tres RadioButton porque hace falta poder deshabilitar una
    opción concreta —Replica en las operaciones que escriben— manteniendo la navegación con
    flechas y sin que el foco caiga en la deshabilitada.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SelectorEntorno" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SunkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding Border.BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RCtl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OpcionEntorno" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ToolTip" Value="{Binding Ayuda}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource RChip}"
                            Height="27"
                            Padding="12,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Punto"
                                     Width="7" Height="7"
                                     Fill="{Binding Marca}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="Etiqueta"
                                       Text="{Binding Nombre}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Ink2Brush}"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                            <!-- Candado en la opción bloqueada: dice que no está por algo -->
                            <Path x:Name="Candado"
                                  Data="M 3.4,7 L 12.6,7 L 12.6,13.6 L 3.4,13.6 Z M 5.6,7 L 5.6,5.4 A 2.4,2.4 0 0 1 10.4,5.4 L 10.4,7"
                                  Stroke="{StaticResource Ink4Brush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="11" Height="11"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Etiqueta" Property="Foreground" Value="{StaticResource MarcaBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="Etiqueta" Property="Foreground" Value="{StaticResource MarcaBrush}" />
                            <Setter TargetName="Etiqueta" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Habilitado}" Value="False">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Punto" Property="Opacity" Value="0.35" />
                            <Setter TargetName="Etiqueta" Property="Foreground" Value="{StaticResource Ink4Brush}" />
                            <Setter TargetName="Candado" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmentado del tipo de lista: Contrato / CUPS / CIF -->
    <Style x:Key="SelectorTipo" TargetType="ListBox" BasedOn="{StaticResource SelectorEntorno}" />

    <Style x:Key="OpcionTipo" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource RChip}"
                            Height="26"
                            Padding="13,0"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Etiqueta"
                                   Text="{Binding Etiqueta}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource Ink2Brush}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Etiqueta" Property="Foreground" Value="{StaticResource MarcaBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="Etiqueta" Property="Foreground" Value="{StaticResource MarcaBrush}" />
                            <Setter TargetName="Etiqueta" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         SELECTOR DE FECHA

         El DatePicker de serie arrastra el aspecto de Windows 7 y aquí aparece en casi
         todas las operaciones, así que sin plantilla propia sería la incoherencia más
         visible de la aplicación.

         La caja interior se estila aparte: DatePickerTextBox trae su propio borde y su
         marca de agua, y hay que quitárselos para que no se dibujen dos bordes.
         ============================================================ -->
    <Style x:Key="CajaFecha" TargetType="DatePickerTextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FechaBase" TargetType="DatePicker">
        <Setter Property="Height" Value="{StaticResource HCtl}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Bd"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource CajaFecha}"
                                               Margin="11,0,0,0"
                                               VerticalAlignment="Center" />

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="30"
                                    Focusable="False"
                                    Cursor="Hand"
                                    ToolTip="Abrir el calendario">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="0,7,7,0">
                                            <Path Data="M 2.2,3.4 L 13.8,3.4 L 13.8,13.8 L 2.2,13.8 Z M 2.2,6.6 L 13.8,6.6 M 5.5,2 L 5.5,4.6 M 10.5,2 L 10.5,4.6"
                                                  Stroke="{StaticResource Ink3Brush}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="15" Height="15"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource SunkBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- El control mete aquí el Calendar. Sin este Popup, revienta. -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Bd}"
                                   StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Enlace de vuelta a la sección -->
    <Style x:Key="BtnVolver" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{StaticResource RChip}"
                            Padding="7,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 9.6,3.4 L 5,8 L 9.6,12.6"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center" />
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
