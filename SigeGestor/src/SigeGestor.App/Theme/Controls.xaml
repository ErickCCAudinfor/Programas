<!--
    Controles. Cada uno con su ControlTemplate propio: los estilos por defecto de WPF
    arrastran el aspecto de Windows 7 y no hay forma de quitárselo por Setters.

    Los estados de hover y pulsado se hacen con Triggers de plantilla, no con Storyboards,
    porque son cambios de color instantáneos; la animación queda para lo que se mueve.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ============================================================
         BOTÓN SECUNDARIO  (el de por defecto)
         ============================================================ -->
    <Style x:Key="BtnSecondary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Height" Value="{StaticResource HCtl}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hair2Brush}" />
                        </Trigger>
                        <!-- Tinta, no acento: el acento ES el azul del relleno y no se vería. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BOTÓN PRIMARIO — azul de marca. El entorno lo puede sobreescribir.
         ============================================================ -->
    <!--
        El fondo va por TemplateBinding y con un Setter que da el valor por defecto, no
        clavado en la plantilla: así una operación de escritura contra Producción puede
        pasarle el ámbar del entorno con Background="{Binding ...}" y ganar al Setter.

        Y por eso el hover juega con la opacidad en lugar de cambiar de color: tiene que
        funcionar igual siendo tinta que siendo ámbar.
    -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
        <Setter Property="Foreground" Value="{StaticResource OnMarcaBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource MarcaBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding Background}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.76" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BOTÓN FANTASMA — para acciones terciarias y el cerrar
         ============================================================ -->
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="Height" Value="{StaticResource HCtlSm}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource RChip}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        El botón que borra.

        En reposo pesa igual que sus vecinos: no hace falta asustar a nadie que solo está
        mirando. Al apuntarlo se pone rojo y avisa de que ese no es como los demás.

        Un disparador del ESTILO pisa al de la plantilla —ese orden de precedencia es el que
        hace que esto quepa en ocho líneas en vez de copiar la plantilla entera de BtnGhost—.
    -->
    <Style x:Key="BtnGhostPeligro" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        LOS TRES BOTONES DE LA VENTANA.

        Al quitar el marco de Windows hay que poner los suyos, y aquí la consistencia que
        manda no es la de la aplicación sino la del sistema: van arriba a la derecha, en
        este orden, con la forma y el tamaño de siempre. Lo único que se cambia es el color,
        para que no sea una franja blanca encima de una aplicación oscura.

        El de cerrar se pone ROJO al pasar por encima, como en Windows. Es la única señal
        que distingue «cierro la aplicación» de «la aparto un momento», y se mira poco:
        conviene que no haya que mirarla.
    -->
    <Style x:Key="BtnVentana" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        <Setter Property="IsTabStop" Value="False" />
        <!--
            BorderBrush se usa aquí como COLOR DE HOVER, que es lo único que distingue al de
            cerrar de los otros dos. No vale un estilo derivado con un disparador propio: un
            disparador de plantilla con TargetName gana al TemplateBinding del Border, así
            que el rojo no llegaría a pintarse.
        -->
        <!-- Hair2 y no Elev: en claro Elev es #FFFFFF igual que el panel, y el hover no
             se veria. Hair2 se nota sobre blanco y sobre oscuro. -->
        <Setter Property="BorderBrush" Value="{StaticResource Hair2Brush}" />
        <!-- Sin esto el botón no recibe el clic: se lo come la zona de arrastre. -->
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <Path Data="{TemplateBinding Tag}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.1"
                              StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        El rojo de cerrar es el de Windows y va fijo: no es un color de la aplicación ni
        cambia con el tema, es la señal del sistema.

        Y encima va BLANCO, no InkBrush: en tema claro la tinta es casi negra y sobre ese
        rojo quedaría ilegible. El disparador del estilo pisa al de la plantilla.
    -->
    <Style x:Key="BtnVentanaCerrar" TargetType="Button" BasedOn="{StaticResource BtnVentana}">
        <Setter Property="BorderBrush" Value="#E81123" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Botón de icono cuadrado (cerrar ventana) -->
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Width" Value="{StaticResource HCtlSm}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ============================================================
         CAJA DE TEXTO
         El marcador de posición se saca del Tag: no hace falta un
         control propio ni un adorner.
         ============================================================ -->
    <Style x:Key="InputBase" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Height" Value="{StaticResource HCtl}" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Ph"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource Ink4Brush}"
                                       FontSize="{StaticResource FsBody}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante en error: borde rojo. Se aplica desde el ViewModel. -->
    <Style x:Key="InputError" TargetType="TextBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BadBrush}"
                            BorderThickness="1.4"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Ph"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource Ink4Brush}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CAJA DE CONTRASEÑA
         PasswordBox no expone Password como propiedad enlazable a
         propósito, así que la lee el code-behind de la vista.
         ============================================================ -->
    <Style x:Key="PasswordBase" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Height" Value="{StaticResource HCtl}" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCtl}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         OPCIÓN EXCLUYENTE
         Para reglas que se excluyen entre sí. Si se usara una casilla,
         no se vería que elegir una descarta la otra.
         ============================================================ -->
    <Style x:Key="RadioBase" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Aro"
                                Width="17" Height="17"
                                CornerRadius="9"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource Ink4Brush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Punto"
                                     Width="7" Height="7"
                                     Fill="{StaticResource MarcaBrush}"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Aro" Property="BorderBrush" Value="{StaticResource MarcaBrush}" />
                            <Setter TargetName="Punto" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Aro" Property="BorderBrush" Value="{StaticResource Ink2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Aro" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CASILLA
         ============================================================ -->
    <Style x:Key="CheckBase" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Bx"
                                Width="17" Height="17"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource Ink4Brush}"
                                BorderThickness="1.5"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Data="M 2.2,6.2 L 4.6,8.6 L 9.8,3.4"
                                  Stroke="{StaticResource OnInkBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bx" Property="Background" Value="{StaticResource MarcaBrush}" />
                            <Setter TargetName="Bx" Property="BorderBrush" Value="{StaticResource MarcaBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bx" Property="BorderBrush" Value="{StaticResource Ink2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bx" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
