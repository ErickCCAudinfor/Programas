<!--
    DESPLEGABLES Y BARRAS DE DESPLAZAMIENTO

    Faltaban. Hasta ahora había 16 estilos de botón, 4 de caja de texto y 2 de casilla, pero
    ninguno de ComboBox ni de ScrollBar: los 15 desplegables de la aplicación y todas las
    barras usaban el aspecto de Windows. En tema claro casi encajaba y nadie lo miró; al
    hacer el tema oscuro saltó a la vista, porque se quedaban claros en medio de una pantalla
    oscura.

    Van SIN x:Key, es decir, implícitos: los coge todo ComboBox y toda ScrollBar sin tocar
    ninguna vista.

    El lenguaje es el de InputBase, para que un desplegable y una caja de texto puestos uno
    al lado del otro —que es como están en media aplicación— se vean iguales: misma altura
    (HCtl), mismo radio (RCtl), mismo borde (Hair) y el mismo azul al enfocar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctr="clr-namespace:SigeGestor.App.Controles">

    <!-- ============================================================
         Cada línea del desplegable
         ============================================================ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RChip}"
                            Margin="4,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                        </Trigger>
                        <!-- La seleccionada se tiñe, NO se invierte el texto: es la misma
                             regla que las rejillas, donde el blanco sobre azul claro dejaba
                             la fila ilegible. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MarcaSuaveBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         El desplegable
         ============================================================ -->
    <Style TargetType="ComboBox">
        <!-- Sin esto, un ComboBox con DisplayMemberPath muestra el nombre del TIPO mientras
             no se haya desplegado la lista. Ver ComboConPlantilla. -->
        <Setter Property="ctr:ComboConPlantilla.Activo" Value="True" />
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontSize" Value="{StaticResource FsBody}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Height" Value="{StaticResource HCtl}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- El marco entero es el botón: pulsar en cualquier sitio abre. -->
                        <ToggleButton x:Name="Alternar"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource HairBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RCtl}"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="Cheuron"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,11,0"
                                              Width="9" Height="6"
                                              Stretch="Fill"
                                              Fill="{StaticResource Ink3Brush}"
                                              Data="M 0,0 L 5,5 L 10,0 Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                                            <Setter TargetName="Cheuron" Property="Fill" Value="{StaticResource Ink4Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Lo elegido. IsHitTestVisible a False para que el clic llegue
                             al ToggleButton de debajo.

                             ContentTemplate va contra ItemTemplate y NO contra
                             SelectionBoxItemTemplate, que es lo que pone la plantilla de
                             Windows: ese llega a NULL mientras no se haya desplegado la
                             lista, y el ContentPresenter cae en ToString(). Con ItemTemplate
                             funciona desde el primer momento. Para los desplegables que
                             llevan DisplayMemberPath, el ItemTemplate lo crea
                             ComboConPlantilla; y los que solo tienen ComboBoxItem con texto
                             no necesitan ninguno. -->
                        <ContentPresenter x:Name="Elegido"
                                          Margin="11,0,30,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding ItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                        <!-- La caja del modo editable. Hoy no la usa nadie, pero la plantilla
                             tiene que traerla: sin un PART_EditableTextBox, poner
                             IsEditable="True" deja el desplegable mudo y sin avisar. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="11,0,30,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{StaticResource InkBrush}"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="Collapsed" />

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource ElevBrush}"
                                    BorderBrush="{StaticResource HairBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RCtl}"
                                    Margin="0,4,0,0"
                                    Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Alternar" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Elegido" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Barras de desplazamiento

         Finas y sin botones de flecha. Las de Windows son anchas, con dos flechitas que
         nadie pulsa, y en oscuro se quedaban grises claras.
         ============================================================ -->
    <Style x:Key="PulgarBarra" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{StaticResource Ink4Brush}"
                            CornerRadius="4"
                            Margin="3"
                            Opacity="0.55"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sin flechas: el botón de la punta se deja de alto cero. -->
    <Style x:Key="SinFlecha" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SinFlecha}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PulgarBarra}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SinFlecha}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="11" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SinFlecha}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PulgarBarra}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SinFlecha}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
