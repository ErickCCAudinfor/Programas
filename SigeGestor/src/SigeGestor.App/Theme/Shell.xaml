<!--
    Piezas del shell: barra lateral, barra superior y chips de entorno.

    La barra lateral es un ListBox con agrupación, no una pila de botones: así la selección,
    la navegación con flechas y la accesibilidad salen gratis.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         BARRA LATERAL
         ============================================================ -->
    <Style x:Key="NavLista" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

    <!-- Encabezado de grupo. El grupo vacío no dibuja nada. -->
    <Style x:Key="NavGrupo" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                        <TextBlock x:Name="Titulo"
                                   Text="{Binding Name}"
                                   Style="{StaticResource TxSection}"
                                   Margin="8,13,8,5" />
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Name}" Value="">
                            <Setter TargetName="Titulo" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource RChip}"
                            Height="31"
                            Padding="8,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{Binding Icono}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="15" Height="15"
                                  Opacity="0.85"
                                  VerticalAlignment="Center" />

                            <TextBlock x:Name="Etiqueta"
                                       Grid.Column="1"
                                       Text="{Binding Titulo}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Contador}"
                                       Visibility="{Binding VisibilidadContador}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource Ink4Brush}"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="2"
                                    Visibility="{Binding VisibilidadAvisos}"
                                    MinWidth="17" Height="17"
                                    CornerRadius="9"
                                    Padding="5,0"
                                    Background="{StaticResource BadBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding TextoAvisos}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            <Setter TargetName="Etiqueta" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón de búsqueda de la lateral (⌘K) -->
    <Style x:Key="NavBuscar" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Height="30"
                            Background="{StaticResource SunkBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RCtl}"
                            Padding="9,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IcoBuscar}"
                                  Stroke="{StaticResource Ink4Brush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Buscar"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource Ink4Brush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource HairBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="4,1"
                                    Background="{StaticResource PanelBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10"
                                           Foreground="{StaticResource Ink4Brush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila de usuario, al pie de la lateral -->
    <Style x:Key="NavUsuario" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{StaticResource RCtl}"
                            Padding="7"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         AVATAR
         ============================================================ -->
    <Style x:Key="Avatar" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AvatarTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
