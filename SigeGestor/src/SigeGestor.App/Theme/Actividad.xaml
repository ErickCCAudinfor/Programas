<!--
    LA TABLA DE ACTIVIDAD, en un solo sitio.

    La usan el inicio (últimas ejecuciones) y la página de Ejecuciones (el histórico
    completo con filtros). Estaba escrita dentro de InicioPage; se ha sacado aquí al
    aparecer el segundo consumidor, antes de que hubiera dos copias que mantener.

    Los anchos son fijos y NO SharedSizeGroup: así la cabecera y las filas cuadran sin
    montar un ámbito de tamaño compartido entre dos vistas distintas.
    Si se cambia una columna, hay que cambiarla en la cabecera Y en la fila.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="PlantillaActividad">
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource Hair2Brush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SunkBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="48" Margin="13,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="150" />
                        <ColumnDefinition Width="146" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <!-- Operación -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8"
                                Background="{StaticResource SunkBrush}"
                                BorderBrush="{StaticResource HairBrush}"
                                BorderThickness="1">
                            <Path Data="{Binding Icono}"
                                  Stroke="{StaticResource Ink2Brush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="14" Height="14"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titulo}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitulo}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Ink4Brush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Usuario -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{StaticResource SunkBrush}"
                                BorderBrush="{StaticResource HairBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Iniciales}"
                                       FontSize="9.5" FontWeight="Bold"
                                       Foreground="{StaticResource Ink2Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Usuario}"
                                   FontSize="13"
                                   Foreground="{StaticResource Ink2Brush}"
                                   Margin="8,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Entorno -->
                    <Border Grid.Column="2"
                            Height="21" Padding="8,0"
                            CornerRadius="{StaticResource RChip}"
                            Background="{Binding FondoEntorno}"
                            BorderBrush="{Binding BordeEntorno}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding MarcaEntorno}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AbreviaturaEntorno}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="10.5" FontWeight="Bold"
                                       Foreground="{Binding TextoEntorno}"
                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Resultado -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Resultado}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="12"
                               Foreground="{Binding ColorResultado}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <!-- Estado, y el botón de cancelar si está corriendo -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Height="21" Padding="8,0"
                                CornerRadius="{StaticResource RChip}"
                                Background="{Binding EstadoFondo}"
                                BorderBrush="{Binding EstadoBorde}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding EstadoTexto}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{Binding EstadoColorTexto}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!--
                            CANCELAR. Solo sale en las filas que están corriendo en este equipo;
                            en las del histórico no hay nada que cancelar y VisibilidadCancelar
                            las deja fuera.

                            Va por comando y no por Click: esta plantilla vive en un diccionario
                            de tema y un diccionario no tiene código detrás. El comando solo
                            PIDE cancelar; quien pregunta antes es EjecucionesPage.
                        -->
                        <Button Visibility="{Binding VisibilidadCancelar}"
                                Command="{Binding CancelarCommand}"
                                Style="{StaticResource BtnIcon}"
                                Width="22" Height="22"
                                Margin="7,0,0,0"
                                IsTabStop="False"
                                ToolTip="{Binding AyudaCancelar}">
                            <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{StaticResource BadBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="9" Height="9" />
                        </Button>
                    </StackPanel>

                    <!-- Duración -->
                    <TextBlock Grid.Column="5"
                               Text="{Binding Duracion}"
                               Style="{StaticResource TxMono}"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!-- Cuándo -->
                    <TextBlock Grid.Column="6"
                               Text="{Binding Cuando}"
                               FontSize="11.5"
                               Foreground="{StaticResource Ink4Brush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

    <!-- Cabecera. Quien la use decide su Visibility. -->
    <ControlTemplate x:Key="CabeceraActividadPlantilla" TargetType="Control">
        <Border Background="{StaticResource SunkBrush}"
                BorderBrush="{StaticResource HairBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="11,11,0,0">
            <Grid Height="34" Margin="13,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="146" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Operación" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Quién" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Entorno" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Resultado" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Grid.Column="4" Text="Estado" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Duración" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="6" Text="Cuándo" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </ControlTemplate>

</ResourceDictionary>
