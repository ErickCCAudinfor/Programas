<Application x:Class="SigeGestor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Sin StartupUri: el arranque lo controla App.xaml.cs, porque primero hay que pasar
        por el login y solo después se abre la ventana principal.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Typography.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
                <ResourceDictionary Source="Theme/Shell.xaml" />
                <ResourceDictionary Source="Theme/Formulario.xaml" />
                <ResourceDictionary Source="Theme/Rejilla.xaml" />
                <ResourceDictionary Source="Theme/Actividad.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
