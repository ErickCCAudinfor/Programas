<UserControl x:Class="SigeGestor.App.Views.Paginas.InicioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SigeGestor.App.Controles"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>

        <!-- ============================================================
             TARJETA DE MÉTRICA
             ============================================================ -->
        <DataTemplate x:Key="PlantillaMetrica">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RCard}"
                    Padding="14,13"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <!-- Rótulo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Path Data="{Binding Icono}"
                              Stroke="{StaticResource Ink4Brush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="13" Height="13"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Titulo}"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink3Brush}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        Cifra + delta.

                        La cifra grande va en la tipográfica de interfaz con NumeralAlignment
                        tabular, NO en monoespaciada: en mono la coma y los dos puntos ocupan
                        una celda entera igual que un dígito, y a este tamaño se lee «1 , 87»
                        y «2 : 14». Tabular da columnas alineadas sin ese hueco.
                        La mono se reserva para los datos pequeños.
                    -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock Text="{Binding Valor}"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{Binding ColorValor}"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding Unidad}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource Ink4Brush}"
                                   Margin="3,0,0,3"
                                   VerticalAlignment="Bottom" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="9,0,0,4"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding VisibilidadDelta}">
                            <Path Data="{Binding FlechaIcono}"
                                  Visibility="{Binding VisibilidadFlecha}"
                                  Stroke="{Binding ColorDelta}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="11" Height="11"
                                  Margin="0,0,2,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Delta}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ColorDelta}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sparkline -->
                    <ctl:Sparkline Grid.Row="2"
                                   Margin="0,4,0,0"
                                   Valores="{Binding Serie}"
                                   Trazo="{Binding TrazoSparkline}"
                                   Relleno="{Binding RellenoSparkline}"
                                   Punto="{Binding PuntoSparkline}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================================================
             TARJETA DE ACCESO RÁPIDO
             ============================================================ -->
        <DataTemplate x:Key="PlantillaAcceso">
            <!--
                El fondo y el borde van en un Style, no como valores locales: un valor local
                tiene más precedencia que el Setter de un Trigger, así que puestos a mano el
                hover no llegaría a aplicarse nunca.
            -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource RCard}"
                    Padding="14"
                    Margin="0,0,12,0"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                        <Setter Property="BorderBrush" Value="{Binding BordeTarjeta}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SunkBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Width="30" Height="30"
                            CornerRadius="8"
                            Background="{StaticResource SunkBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left">
                        <Path Data="{Binding Icono}"
                              Stroke="{StaticResource Ink2Brush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="15" Height="15"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Titulo}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="6" Height="6"
                                 Fill="{Binding MarcaEntorno}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AbreviaturaEntorno}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{Binding TextoEntorno}"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Detalle}"
                                   Style="{StaticResource TxMono}"
                                   FontSize="11"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- La plantilla de fila y la cabecera de esta tabla viven en
             Theme/Actividad.xaml: las comparte con la página de Ejecuciones. -->

        <!-- Esqueleto de carga -->
        <Style x:Key="Esqueleto" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Hair2Brush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RChip}" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,24,26,28">
        <Grid>
            <!-- ============================================================
                 CARGANDO — esqueletos con la misma silueta que el contenido
                 ============================================================ -->
            <StackPanel Visibility="{Binding VisibilidadCargando}">
                <Border Style="{StaticResource Esqueleto}" Width="240" Height="26" HorizontalAlignment="Left" />
                <Border Style="{StaticResource Esqueleto}" Width="340" Height="13" HorizontalAlignment="Left" Margin="0,10,0,0" />
                <UniformGrid Columns="4" Margin="0,24,0,0" Height="112">
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                </UniformGrid>
                <Border Style="{StaticResource Esqueleto}" Width="150" Height="11" HorizontalAlignment="Left" Margin="0,28,0,0" />
                <UniformGrid Columns="3" Margin="0,12,0,0" Height="124">
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                    <Border Style="{StaticResource Esqueleto}" Margin="0,0,12,0" CornerRadius="{StaticResource RCard}" />
                </UniformGrid>
            </StackPanel>

            <!-- ============================================================
                 ERROR
                 ============================================================ -->
            <Border Visibility="{Binding VisibilidadError}"
                    VerticalAlignment="Top"
                    Padding="14,12"
                    CornerRadius="{StaticResource RCtl}"
                    Background="{StaticResource BadSoftBrush}"
                    BorderBrush="{StaticResource BadLineBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IcoAviso}"
                          Stroke="{StaticResource BadBrush}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="17" Height="17"
                          VerticalAlignment="Top" Margin="0,1,11,0" />
                    <StackPanel>
                        <TextBlock Text="No se han podido cargar las métricas"
                                   FontSize="13" FontWeight="SemiBold" />
                        <!-- HorizontalAlignment explícito: con Stretch y un MaxWidth que
                             impide estirarse, WPF centra el bloque en el hueco. -->
                        <TextBlock Text="{Binding MensajeError}"
                                   Style="{StaticResource TxHelp}"
                                   HorizontalAlignment="Left"
                                   MaxWidth="520" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================
                 CONTENIDO
                 ============================================================ -->
            <StackPanel Visibility="{Binding VisibilidadContenido}">

                <!-- Cabecera -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Saludo}" Style="{StaticResource TxH1}" />
                        <TextBlock Text="{Binding Subtitulo}"
                                   Style="{StaticResource TxBodyMuted}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource BtnSecondary}"
                                Content="Ver ejecuciones"
                                Margin="0,0,9,0" />
                        <Button Style="{StaticResource BtnPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IcoEjecutar}"
                                      Fill="{StaticResource OnInkBrush}"
                                      Stretch="Uniform"
                                      Width="11" Height="11"
                                      Margin="0,0,7,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Nueva ejecución" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Métricas -->
                <ItemsControl ItemsSource="{Binding Metricas}"
                              ItemTemplate="{StaticResource PlantillaMetrica}"
                              Margin="0,22,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Accesos rápidos -->
                <TextBlock Text="LO QUE MÁS USAS" Style="{StaticResource TxSection}" Margin="0,28,0,0" />

                <ItemsControl ItemsSource="{Binding Accesos}"
                              ItemTemplate="{StaticResource PlantillaAcceso}"
                              Visibility="{Binding VisibilidadAccesos}"
                              Margin="0,11,-12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Visibility="{Binding VisibilidadSinAccesos}"
                        Margin="0,11,0,0" Padding="14,13"
                        CornerRadius="{StaticResource RCard}"
                        Background="{StaticResource SunkBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1">
                    <TextBlock Style="{StaticResource TxHelp}"
                               HorizontalAlignment="Left"
                               Text="Cuando lances alguna operación aparecerán aquí las que más uses." />
                </Border>

                <!-- ============================================================
                     ACTIVIDAD DEL EQUIPO
                     ============================================================ -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ACTIVIDAD DEL EQUIPO" Style="{StaticResource TxSection}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource BtnGhost}"
                            Content="Ver todas"
                            FontSize="12" />
                </Grid>

                <Border Margin="0,10,0,0"
                        CornerRadius="{StaticResource RCard}"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Cabecera de la tabla, compartida -->
                        <Control Template="{StaticResource CabeceraActividadPlantilla}"
                                 Visibility="{Binding VisibilidadActividad}" />

                        <!-- Filas -->
                        <ItemsControl ItemsSource="{Binding Actividad}"
                                      ItemTemplate="{StaticResource PlantillaActividad}"
                                      Visibility="{Binding VisibilidadActividad}" />

                        <!-- Sin actividad: con una retención de pocos días esto es normal -->
                        <StackPanel Visibility="{Binding VisibilidadSinActividad}"
                                    Margin="20,34" HorizontalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="11"
                                    Background="{StaticResource SunkBrush}"
                                    BorderBrush="{StaticResource HairBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Path Data="{StaticResource IcoEjecuciones}"
                                      Stroke="{StaticResource Ink4Brush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="19" Height="19"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sin actividad registrada"
                                       Style="{StaticResource TxCard}"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,0" />
                            <TextBlock Text="{Binding TextoSinActividad}"
                                       Style="{StaticResource TxHelp}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       MaxWidth="360"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
