<UserControl x:Class="SigeGestor.App.Views.Paginas.ModelosImpresionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="26,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0">
            <Button Style="{StaticResource BtnVolver}"
                    Content="Ajustes"
                    HorizontalAlignment="Left"
                    Margin="-7,0,0,0"
                    Click="Volver_Click" />

            <TextBlock Text="Modelos de impresión" Style="{StaticResource TxH1}" Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource TxBodyMuted}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="820"
                       Margin="0,6,0,0"
                       Text="Los modelos con los que SIGE imprime facturas y contratos. Cada empresa tiene los suyos en su propia base, así que un modelo nuevo hay que subirlo a cada una." />

            <TextBlock Text="{Binding Resumen}"
                       Visibility="{Binding VisibilidadResumen}"
                       Foreground="{StaticResource OkBrush}"
                       FontSize="12.5" FontWeight="SemiBold"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="820"
                       Margin="0,13,0,0" />

            <TextBlock Text="{Binding Error}"
                       Visibility="{Binding VisibilidadError}"
                       Style="{StaticResource TxError}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="820"
                       Margin="0,13,0,0" />

            <!-- Sin empresas registradas no hay nada que hacer aquí -->
            <Border Visibility="{Binding VisibilidadSinEmpresas}"
                    Margin="0,16,0,0" Padding="14,12"
                    CornerRadius="{StaticResource RCtl}"
                    Background="{StaticResource WarnSoftBrush}"
                    BorderBrush="{StaticResource ProLineBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="No hay ninguna empresa registrada"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TxHelp}"
                               HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="640"
                               Margin="0,3,0,0"
                               Text="Los modelos viven en la base de cada empresa. Regístralas primero en Ajustes → Empresas y bases de datos." />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Dos columnas: empresas a la izquierda, modelos y masivo a la derecha -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 EMPRESAS
                 ============================================================ -->
            <Border Grid.Column="0"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="15,14,15,0">
                        <TextBlock Text="EMPRESAS" Style="{StaticResource TxSection}" />
                        <TextBlock Style="{StaticResource TxHelp}"
                                   HorizontalAlignment="Left" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="Pulsa una para ver sus modelos. Marca las casillas para operar sobre varias a la vez." />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="ListaEmpresas"
                             Margin="7,11,7,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Destinos}"
                             SelectedItem="{Binding EmpresaActiva, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Fondo"
                                                    Background="Transparent"
                                                    CornerRadius="{StaticResource RCtl}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background"
                                                            Value="{StaticResource SunkBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Fondo" Property="Background"
                                                            Value="{StaticResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource CheckBase}"
                                              VerticalAlignment="Top" Margin="0,1,9,0"
                                              IsChecked="{Binding Elegida, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Visibility="{Binding VisibilidadVpn}"
                                                    Margin="7,0,0,0" Padding="5,1"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="{StaticResource RChip}"
                                                    Background="{StaticResource UatSoftBrush}">
                                                <TextBlock Text="VPN" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource UatBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Descripcion}"
                                                   Style="{StaticResource TxHelp}"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />

                                        <TextBlock Text="{Binding Resultado}"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Resultado}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultadoBien}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="15,11,15,14">
                        <TextBlock Text="{Binding TextoElegidas}"
                                   Foreground="{StaticResource Ink3Brush}"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="Todas" FontSize="12"
                                    Click="MarcarTodas_Click" />
                            <Button Style="{StaticResource BtnGhost}" Content="Ninguna" FontSize="12"
                                    Margin="6,0,0,0"
                                    Click="MarcarNinguna_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 MODELOS Y MASIVO
                 ============================================================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Rejilla de modelos de la empresa activa -->
                <Border Grid.Row="0"
                        CornerRadius="{StaticResource RCard}"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="15,14,15,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Un solo Text, no dos Run: Run.Text está registrado con
                                     BindsTwoWayByDefault, así que enlazar ahí una propiedad de
                                     solo lectura lanza InvalidOperationException al mostrarla. -->
                                <TextBlock Text="{Binding TituloModelos}"
                                           Style="{StaticResource TxCard}" />
                                <TextBlock Text="{Binding Recuento}"
                                           Foreground="{StaticResource Ink3Brush}"
                                           FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource InputBase}"
                                         Width="200" Height="32"
                                         Tag="Filtrar…"
                                         Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource BtnSecondary}" Content="Nuevo"
                                        Margin="9,0,0,0" Click="NuevoModelo_Click" />
                                <Button Style="{StaticResource BtnGhost}" Content="Editar"
                                        Margin="6,0,0,0"
                                        IsEnabled="{Binding HayModelo}"
                                        Click="EditarModelo_Click" />
                                <Button Style="{StaticResource BtnGhost}" Content="Borrar"
                                        Margin="6,0,0,0"
                                        IsEnabled="{Binding HayModelo}"
                                        Click="BorrarModelo_Click" />
                                <Button Style="{StaticResource BtnGhost}" Content="Guardar .rpt"
                                        Margin="6,0,0,0"
                                        IsEnabled="{Binding HayModelo}"
                                        Click="DescargarModelo_Click" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  x:Name="ListaModelos"
                                  Style="{StaticResource Rejilla}"
                                  Margin="4,11,4,4"
                                  ItemsSource="{Binding Modelos}"
                                  SelectedItem="{Binding ModeloSeleccionado, Mode=TwoWay}"
                                  MouseDoubleClick="ListaModelos_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="70" />
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion, Mode=OneWay}" Width="2*" />
                                <DataGridTextColumn Header="ENTORNO" Binding="{Binding Entorno, Mode=OneWay}" Width="110" />
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo, Mode=OneWay}" Width="1.3*" />
                                <DataGridTextColumn Header="CLASE" Binding="{Binding ClassName, Mode=OneWay}" Width="1.4*" />
                                <DataGridTextColumn Header="FICHERO" Binding="{Binding RptFileName, Mode=OneWay}" Width="1.4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Masivo -->
                <Border Grid.Row="1" Margin="0,18,0,0"
                        CornerRadius="{StaticResource RCard}"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="SUBIR A VARIAS EMPRESAS" Style="{StaticResource TxSection}" />
                        <TextBlock Style="{StaticResource TxHelp}"
                                   HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="700"
                                   Margin="0,6,0,0"
                                   Text="Se aplica a las empresas marcadas en la lista de la izquierda. «Actualizar» busca el modelo por descripción, entorno y tipo; «Comprobar» solo mira si lo tienen, sin escribir nada." />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Descripción" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource InputBase}"
                                         MaxLength="250"
                                         Text="{Binding DescripcionMasivo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Entorno" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                                <ComboBox x:Name="EntornoMasivo" Height="34" FontSize="13.5"
                                          SelectionChanged="EntornoMasivo_SelectionChanged">
                                    <ComboBoxItem Content="Luz (G1)" Tag="G1" IsSelected="True" />
                                    <ComboBoxItem Content="Gas (G2)" Tag="G2" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tipo" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                                <ComboBox Height="34" FontSize="13.5"
                                          ItemsSource="{Binding Tipos}"
                                          DisplayMemberPath="Nombre"
                                          SelectedItem="{Binding TipoMasivo, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Clase (ClassName)" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource InputBase}"
                                         MaxLength="250"
                                         Text="{Binding ClassNameMasivo, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Report (.rpt)" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBase}"
                                             IsReadOnly="True"
                                             Text="{Binding TextoReport, Mode=OneWay}" />
                                    <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                            Content="Elegir…" Margin="8,0,0,0"
                                            Click="ElegirReportMasivo_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Content="Subir a las marcadas"
                                    IsEnabled="{Binding PuedeSubir}"
                                    Click="Subir_Click" />
                            <Button Style="{StaticResource BtnSecondary}" Content="Actualizar en las marcadas"
                                    Margin="9,0,0,0"
                                    IsEnabled="{Binding PuedeActualizar}"
                                    Click="Actualizar_Click" />
                            <Button Style="{StaticResource BtnGhost}" Content="Comprobar"
                                    Margin="9,0,0,0"
                                    IsEnabled="{Binding PuedeComprobar}"
                                    Click="Comprobar_Click" />
                            <Button Style="{StaticResource BtnGhost}" Content="Cancelar"
                                    Margin="9,0,0,0"
                                    IsEnabled="{Binding Trabajando}"
                                    Click="Cancelar_Click" />

                            <TextBlock Text="{Binding Progreso}"
                                       Visibility="{Binding VisibilidadProgreso}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource Ink3Brush}"
                                       FontFamily="{StaticResource FontMono}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
