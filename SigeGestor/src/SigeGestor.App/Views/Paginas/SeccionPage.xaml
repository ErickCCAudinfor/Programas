<UserControl x:Class="SigeGestor.App.Views.Paginas.SeccionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SigeGestor.App.Converters"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>

        <conv:AnchoAColumnasConverter x:Key="AColumnas" />

        <!-- Encabezado de subgrupo. El subgrupo vacío no dibuja nada. -->
        <Style x:Key="SubgrupoItem" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <TextBlock x:Name="Titulo"
                                       Text="{Binding Name}"
                                       Style="{StaticResource TxSection}"
                                       Margin="0,18,0,8" />
                            <ItemsPresenter />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name}" Value="">
                                <Setter TargetName="Titulo" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             TARJETA DE OPERACIÓN

             Antes era una fila a todo lo ancho. En rejilla la tarjeta es más estrecha, así
             que hay dos diferencias que importan:

               - El nombre ENVUELVE en vez de recortarse con puntos suspensivos. A 400 px
                 «Actualizar email, móvil y teléfono» se quedaba en «Actualizar email, mó…»,
                 que no distingue una operación de otra.
               - El chip «Escribe» va en un WrapPanel con el nombre: si no cabe en la misma
                 línea baja, en lugar de empujar al nombre y recortarlo.

             Las tres filas son Auto / * / Auto a propósito. La del medio es la que estira,
             así que la línea de entradas queda a la misma altura en todas las tarjetas de
             una fila y no bailando según lo larga que sea cada descripción.
             ============================================================ -->
        <Style x:Key="TarjetaOperacion" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource HairBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RCard}"
                                Padding="15,14"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Cabecera: icono, nombre y entorno -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="34" Height="34" CornerRadius="9"
                                            Background="{StaticResource SunkBrush}"
                                            BorderBrush="{StaticResource HairBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <Path Data="{Binding Icono}"
                                              Stroke="{StaticResource Ink2Brush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <WrapPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,9,0" />
                                        <Border Visibility="{Binding VisibilidadEscritura}"
                                                Height="19" Padding="7,0"
                                                CornerRadius="{StaticResource RChip}"
                                                Background="{StaticResource WarnSoftBrush}"
                                                BorderBrush="{StaticResource ProLineBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Escribe"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Visibility="{Binding VisibilidadPendiente}"
                                                Margin="7,0,0,0"
                                                Height="19" Padding="7,0"
                                                CornerRadius="{StaticResource RChip}"
                                                Background="{StaticResource SunkBrush}"
                                                BorderBrush="{StaticResource HairBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Pendiente"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource Ink4Brush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </WrapPanel>

                                    <Border Grid.Column="2"
                                            Height="21" Padding="8,0"
                                            CornerRadius="{StaticResource RChip}"
                                            Background="{Binding FondoEntorno}"
                                            BorderBrush="{Binding BordeEntorno}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            Margin="0,2,0,0"
                                            ToolTip="Entorno con el que se abre">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding MarcaEntorno}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AbreviaturaEntorno}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding TextoEntorno}"
                                                       Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Descripción -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Descripcion}"
                                           Style="{StaticResource TxHelp}"
                                           VerticalAlignment="Top"
                                           Margin="0,11,0,0" />

                                <!-- Pie: entradas requeridas y cheurón -->
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Entradas}"
                                               Style="{StaticResource TxMono}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <Path Grid.Column="1"
                                          Data="{StaticResource IcoCheuronDer}"
                                          Stroke="{StaticResource Ink4Brush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"
                                          Width="12" Height="12"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,24,26,28">
        <StackPanel>

            <!-- Cabecera -->
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{StaticResource SunkBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <Path Data="{Binding Icono}"
                          Stroke="{StaticResource Ink2Brush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="19" Height="19"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxH1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Recuento}" Style="{StaticResource TxBodyMuted}" />
                        <TextBlock Text="·" Foreground="{StaticResource Ink4Brush}" Margin="7,0" />
                        <TextBlock Text="{Binding Progreso}" Style="{StaticResource TxHelp}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Descripcion}"
                       Style="{StaticResource TxBodyMuted}"
                       HorizontalAlignment="Left"
                       MaxWidth="640"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <!-- Operaciones -->
            <!--
                IsSynchronizedWithCurrentItem="False" NO SE PUEDE QUITAR.

                Por omisión es null, que en WPF significa «true si el ItemsSource es una
                CollectionView». Aquí lo es, y una vista recién creada tiene el primer elemento
                como actual, así que el ListBox lo seleccionaba solo al aparecer, disparaba
                SelectionChanged y abría la primera operación de la sección. Entrar en Contratos
                te metía directo en «Volver a renovar» y había que darle a volver para ver la
                lista.
            -->
            <ListBox x:Name="Lista"
                     IsSynchronizedWithCurrentItem="False"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,10,-12,0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource TarjetaOperacion}"
                     ItemsSource="{Binding Vista.View}">
                <!--
                    El UniformGrid va en ItemsPanel, que con agrupación es quien coloca las
                    OPERACIONES dentro de cada grupo. Puesto en GroupStyle.Panel coloca los
                    grupos: la primera versión hizo eso y el resultado fue «Generales» y
                    «Pool» en dos columnas, con sus operaciones apiladas dentro de media
                    pantalla. Compilaba, y Columns valía 2.

                    UniformGrid y no WrapPanel porque el WrapPanel exige un ancho fijo por
                    tarjeta (ItemWidth) y entonces sobra un hueco a la derecha que cambia con
                    cada tamaño de ventana. El UniformGrid reparte el ancho real entre las
                    columnas y, además, iguala la altura de las tarjetas de una misma fila.

                    Columns sale del ancho del ListBox, no del de la ventana: la barra lateral
                    y el relleno del ScrollViewer se comen unos 290 px que la ventana no
                    descuenta.

                    Se pierde la virtualización, que el UniformGrid no hace. Es asumible: la
                    sección más poblada es Consultas con 21 tarjetas.
                -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding ActualWidth,
                                                RelativeSource={RelativeSource AncestorType={x:Type ListBox}},
                                                Converter={StaticResource AColumnas}}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource SubgrupoItem}" />
                </ListBox.GroupStyle>
            </ListBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
