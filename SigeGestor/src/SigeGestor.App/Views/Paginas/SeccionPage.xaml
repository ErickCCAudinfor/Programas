<UserControl x:Class="SigeGestor.App.Views.Paginas.SeccionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>

        <!-- Encabezado de subgrupo. El subgrupo vacío no dibuja nada. -->
        <Style x:Key="SubgrupoItem" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <TextBlock x:Name="Titulo"
                                       Text="{Binding Name}"
                                       Style="{StaticResource TxSection}"
                                       Margin="0,18,0,8" />
                            <ItemsPresenter />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name}" Value="">
                                <Setter TargetName="Titulo" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             FILA DE OPERACIÓN
             ============================================================ -->
        <Style x:Key="FilaOperacion" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource HairBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RCard}"
                                Padding="15,13"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icono -->
                                <Border Grid.Column="0"
                                        Width="34" Height="34" CornerRadius="9"
                                        Background="{StaticResource SunkBrush}"
                                        BorderBrush="{StaticResource HairBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <Path Data="{Binding Icono}"
                                          Stroke="{StaticResource Ink2Brush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Texto -->
                                <StackPanel Grid.Column="1" Margin="13,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Visibility="{Binding VisibilidadEscritura}"
                                                Margin="9,0,0,0"
                                                Height="19" Padding="7,0"
                                                CornerRadius="{StaticResource RChip}"
                                                Background="{StaticResource WarnSoftBrush}"
                                                BorderBrush="{StaticResource ProLineBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Escribe"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Visibility="{Binding VisibilidadPendiente}"
                                                Margin="7,0,0,0"
                                                Height="19" Padding="7,0"
                                                CornerRadius="{StaticResource RChip}"
                                                Background="{StaticResource SunkBrush}"
                                                BorderBrush="{StaticResource HairBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Pendiente"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource Ink4Brush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Descripcion}"
                                               Style="{StaticResource TxHelp}"
                                               Margin="0,4,0,0"
                                               MaxWidth="560"
                                               HorizontalAlignment="Left" />

                                    <TextBlock Text="{Binding Entradas}"
                                               Style="{StaticResource TxMono}"
                                               FontSize="11"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Entorno por defecto -->
                                <Border Grid.Column="2"
                                        Height="21" Padding="8,0"
                                        CornerRadius="{StaticResource RChip}"
                                        Background="{Binding FondoEntorno}"
                                        BorderBrush="{Binding BordeEntorno}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Margin="0,2,12,0"
                                        ToolTip="Entorno con el que se abre">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{Binding MarcaEntorno}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AbreviaturaEntorno}"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{Binding TextoEntorno}"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Path Grid.Column="3"
                                      Data="{StaticResource IcoCheuronDer}"
                                      Stroke="{StaticResource Ink4Brush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      VerticalAlignment="Top"
                                      Margin="0,9,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink4Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SunkBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,24,26,28">
        <StackPanel>

            <!-- Cabecera -->
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="11"
                        Background="{StaticResource SunkBrush}"
                        BorderBrush="{StaticResource HairBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <Path Data="{Binding Icono}"
                          Stroke="{StaticResource Ink2Brush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="19" Height="19"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxH1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Recuento}" Style="{StaticResource TxBodyMuted}" />
                        <TextBlock Text="·" Foreground="{StaticResource Ink4Brush}" Margin="7,0" />
                        <TextBlock Text="{Binding Progreso}" Style="{StaticResource TxHelp}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Descripcion}"
                       Style="{StaticResource TxBodyMuted}"
                       HorizontalAlignment="Left"
                       MaxWidth="640"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <!-- Operaciones -->
            <ListBox x:Name="Lista"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,10,0,0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource FilaOperacion}"
                     ItemsSource="{Binding Vista.View}">
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource SubgrupoItem}" />
                </ListBox.GroupStyle>
            </ListBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
