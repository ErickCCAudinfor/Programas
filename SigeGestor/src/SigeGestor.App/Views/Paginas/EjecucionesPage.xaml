<UserControl x:Class="SigeGestor.App.Views.Paginas.EjecucionesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             CABECERA Y FILTROS
             ============================================================ -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Ejecuciones" Style="{StaticResource TxH1}" />
            <TextBlock Style="{StaticResource TxBodyMuted}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="820"
                       Margin="0,6,0,0"
                       Text="Todo lo que ha lanzado el equipo, de lo más reciente a lo más antiguo. El histórico se conserva unos pocos días." />

            <!-- Los filtros, en una fila que envuelve si la ventana es estrecha -->
            <WrapPanel Margin="0,18,0,0">

                <TextBox Style="{StaticResource InputBase}"
                         Width="230" Margin="0,0,9,9"
                         Tag="Buscar operación, detalle, quién…"
                         Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox Height="34" FontSize="13.5" Width="160" Margin="0,0,9,9"
                          ItemsSource="{Binding Secciones}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding Seccion, Mode=TwoWay}" />

                <ComboBox Height="34" FontSize="13.5" Width="160" Margin="0,0,9,9"
                          ItemsSource="{Binding Personas}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding Persona, Mode=TwoWay}" />

                <ComboBox Height="34" FontSize="13.5" Width="150" Margin="0,0,9,9"
                          ItemsSource="{Binding Entornos}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding Entorno, Mode=TwoWay}" />

                <ComboBox Height="34" FontSize="13.5" Width="155" Margin="0,0,9,9"
                          ItemsSource="{Binding Estados}"
                          DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding Estado, Mode=TwoWay}" />

                <CheckBox Style="{StaticResource CheckBase}"
                          Content="Solo mías"
                          VerticalAlignment="Center"
                          Margin="4,0,12,9"
                          IsChecked="{Binding SoloMias, Mode=TwoWay}" />

                <Button Style="{StaticResource BtnGhost}"
                        Content="Quitar filtros"
                        Margin="0,0,9,9"
                        IsEnabled="{Binding HayFiltro}"
                        Click="Limpiar_Click" />

                <Button Style="{StaticResource BtnSecondary}"
                        Content="Recargar"
                        Margin="0,0,0,9"
                        Click="Recargar_Click" />
            </WrapPanel>

            <!-- Recuento y resumen de lo filtrado -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding Recuento}"
                           Foreground="{StaticResource Ink3Brush}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12" FontWeight="Bold" />
                <TextBlock Text="{Binding Resumen}"
                           Foreground="{StaticResource Ink4Brush}"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="12"
                           Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding Error}"
                       Visibility="{Binding VisibilidadError}"
                       Style="{StaticResource TxError}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="820"
                       Margin="0,12,0,0" />
        </StackPanel>

        <!-- ============================================================
             TABLA — la fila y la cabecera son las mismas del inicio,
             desde Theme/Actividad.xaml
             ============================================================ -->
        <Border Grid.Row="1" Margin="0,14,0,0"
                CornerRadius="{StaticResource RCard}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Control Grid.Row="0"
                         Template="{StaticResource CabeceraActividadPlantilla}"
                         Visibility="{Binding VisibilidadFilas}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Filas}"
                                  ItemTemplate="{StaticResource PlantillaActividad}"
                                  Visibility="{Binding VisibilidadFilas}" />
                </ScrollViewer>

                <!-- Cargando -->
                <TextBlock Grid.Row="1"
                           Visibility="{Binding VisibilidadCargando}"
                           Text="Leyendo el histórico…"
                           Foreground="{StaticResource Ink4Brush}"
                           FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Vacío: se distingue «no hay log» de «los filtros no dejan pasar nada» -->
                <StackPanel Grid.Row="1"
                            Visibility="{Binding VisibilidadVacio}"
                            Margin="20,40" MaxWidth="440"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{StaticResource SunkBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Path Data="{StaticResource IcoEjecuciones}"
                              Stroke="{StaticResource Ink4Brush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Width="19" Height="19"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding TextoVacio}"
                               Style="{StaticResource TxHelp}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
