<UserControl x:Class="SigeGestor.App.Views.Paginas.EmpresasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="26,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Button Style="{StaticResource BtnVolver}"
                    Content="Ajustes"
                    HorizontalAlignment="Left"
                    Margin="-7,0,0,0"
                    Click="Volver_Click" />

            <TextBlock Text="Empresas y bases de datos" Style="{StaticResource TxH1}" Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource TxBodyMuted}"
                       TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="720"
                       Margin="0,6,0,0"
                       Text="Las bases de clientes a las que se suben los modelos de impresión. No son los entornos de las operaciones: Producción, Réplica y UAT se configuran en Entornos.json y no se tocan desde aquí." />

            <!-- Dónde está el fichero: con el .exe en el .13 conviene que se vea -->
            <TextBlock Style="{StaticResource TxHelp}"
                       HorizontalAlignment="Left" Margin="0,10,0,0"
                       FontFamily="{StaticResource FontMono}" FontSize="11.5"
                       Text="{Binding Ruta}" />

            <!-- Barra de acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource BtnPrimary}" Content="Nueva empresa"
                        Click="Nueva_Click" />
                <Button Style="{StaticResource BtnSecondary}" Content="Editar"
                        Margin="9,0,0,0"
                        IsEnabled="{Binding HaySeleccion}"
                        Click="Editar_Click" />
                <Button Style="{StaticResource BtnGhost}" Content="Eliminar"
                        Margin="9,0,0,0"
                        IsEnabled="{Binding HaySeleccion}"
                        Click="Eliminar_Click" />

                <Border Width="1" Margin="14,4" Background="{StaticResource HairBrush}" />

                <Button Style="{StaticResource BtnSecondary}" Content="Probar todas"
                        Click="Probar_Click" />
                <Button Style="{StaticResource BtnGhost}" Content="Recargar"
                        Margin="9,0,0,0"
                        Click="Recargar_Click" />

                <TextBlock Text="{Binding Recuento}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource Ink3Brush}"
                           FontFamily="{StaticResource FontMono}" FontSize="12" />
            </StackPanel>

            <TextBlock Text="{Binding Aviso}"
                       Visibility="{Binding VisibilidadAviso}"
                       Foreground="{StaticResource OkBrush}"
                       FontSize="12.5" FontWeight="SemiBold"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="720"
                       Margin="0,13,0,0" />

            <TextBlock Text="{Binding Error}"
                       Visibility="{Binding VisibilidadError}"
                       Style="{StaticResource TxError}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="720"
                       Margin="0,13,0,0" />
        </StackPanel>

        <!-- Rejilla -->
        <Border Grid.Row="1" Margin="0,18,0,0"
                CornerRadius="{StaticResource RCard}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource HairBrush}"
                BorderThickness="1">
            <Grid>
                <DataGrid x:Name="Lista"
                          Style="{StaticResource Rejilla}"
                          Margin="4,10,4,4"
                          ItemsSource="{Binding Empresas}"
                          SelectedItem="{Binding Seleccionada, Mode=TwoWay}"
                          MouseDoubleClick="Lista_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre, Mode=OneWay}" Width="1.4*" />
                        <DataGridTextColumn Header="SERVIDOR" Binding="{Binding Servidor, Mode=OneWay}" Width="1.6*" />
                        <DataGridTextColumn Header="BASE DE DATOS" Binding="{Binding BaseDatos, Mode=OneWay}" Width="1.3*" />
                        <DataGridTextColumn Header="USUARIO" Binding="{Binding Usuario, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="VPN" Binding="{Binding Vpn, Mode=OneWay}" Width="60" />
                        <DataGridTemplateColumn Header="CONEXIÓN" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Estado}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Estado}"
                                               FontSize="12.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstadoBien}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Vacío: se dice qué hacer, no se deja un recuadro en blanco -->
                <StackPanel Visibility="{Binding VisibilidadVacio}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock Text="Todavía no hay ninguna empresa"
                               Style="{StaticResource TxCard}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource TxHelp}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,8,0,0"
                               Text="Puedes registrarlas una a una, o copiar el EmpresasBD.json de ActualizaPrecios a Config\Empresas.json: el formato y el cifrado son los mismos." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
