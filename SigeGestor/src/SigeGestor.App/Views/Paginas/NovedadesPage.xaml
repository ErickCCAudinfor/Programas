<UserControl x:Class="SigeGestor.App.Views.Paginas.NovedadesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />

        <!-- Una versión: cabecera, y la lista de cambios con su viñeta -->
        <DataTemplate x:Key="PlantillaNovedad">
            <Border Margin="0,0,0,14"
                    Padding="17,15"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <!--
                        LA CABECERA PLIEGA Y DESPLIEGA.

                        Es un ToggleButton con la plantilla cambiada —no un Expander— por dos
                        motivos: el Expander trae su propio triángulo y su propio marco, que
                        no son los de aquí, y así la zona que se pulsa es la cabecera entera y
                        no solo una flecha de 12 px.

                        Empieza desplegada la versión que trae algo sin leer y plegadas las
                        demás; lo decide Expandido en el ViewModel.
                    -->
                    <ToggleButton IsChecked="{Binding Expandido, Mode=TwoWay}"
                                  Cursor="Hand"
                                  HorizontalContentAlignment="Stretch"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  Focusable="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource TxCard}" />

                                    <Border Visibility="{Binding VisibilidadNueva}"
                                            Margin="9,0,0,0" Padding="6,1"
                                            VerticalAlignment="Center"
                                            CornerRadius="{StaticResource RChip}"
                                            Background="{StaticResource MarcaSuaveBrush}"
                                            BorderBrush="{StaticResource MarcaLineaBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="NUEVO" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource MarcaBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Titulo}"
                                           FontSize="13.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" TextWrapping="Wrap"
                                           Margin="0,7,0,0" />

                                <TextBlock Style="{StaticResource TxHelp}"
                                           HorizontalAlignment="Left" Margin="0,3,0,0">
                                    <Run Text="{Binding Fecha, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Recuento, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Path Grid.Column="1"
                                  Data="{StaticResource IcoCheuronAbajo}"
                                  Stroke="{StaticResource Ink4Brush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Top"
                                  Margin="10,4,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <!--
                                    El giro va SOLO en el Style, sin RenderTransform puesto
                                    aquí al lado. Un valor local gana a los Setter de un
                                    trigger, asi que con los dos el cheuron se quedaba
                                    apuntando siempre hacia abajo, tambien en las plegadas.
                                -->
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <!-- Desplegada: apunta hacia abajo. -->
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Plegada: apunta a la derecha. -->
                                            <DataTrigger Binding="{Binding Expandido}" Value="False">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="-90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </ToggleButton>

                    <ItemsControl ItemsSource="{Binding Cambios}" Margin="0,12,0,0"
                                  Visibility="{Binding Expandido, Converter={StaticResource BoolAVisibilidad}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Viñeta dibujada, no un carácter: así queda alineada
                                         con la primera línea y no baila con el tamaño. -->
                                    <Ellipse Grid.Column="0"
                                             Width="4" Height="4"
                                             Fill="{StaticResource Ink4Brush}"
                                             VerticalAlignment="Top" Margin="2,7,11,0" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               FontSize="13"
                                               Foreground="{StaticResource Ink2Brush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,18,26,28">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">

            <TextBlock Text="Novedades" Style="{StaticResource TxH1}" />

            <TextBlock Style="{StaticResource TxBodyMuted}"
                       TextWrapping="Wrap" HorizontalAlignment="Left"
                       Margin="0,6,0,0">
                <Run Text="{Binding TextoNuevas, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding VersionInstalada, Mode=OneWay}" />
            </TextBlock>

            <!-- La versión más reciente, destacada -->
            <ContentControl Content="{Binding Actual}"
                            ContentTemplate="{StaticResource PlantillaNovedad}"
                            Margin="0,20,0,0" />

            <!-- El resto del historial -->
            <StackPanel Visibility="{Binding VisibilidadAnteriores}">
                <TextBlock Text="VERSIONES ANTERIORES"
                           Style="{StaticResource TxSection}"
                           Margin="0,14,0,11" />

                <ItemsControl ItemsSource="{Binding Anteriores}"
                              ItemTemplate="{StaticResource PlantillaNovedad}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
