<UserControl x:Class="SigeGestor.App.Views.Paginas.EjecucionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SigeGestor.App.Controles"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>
        <!-- Fila del registro en vivo -->
        <DataTemplate x:Key="PlantillaLinea">
            <Border Background="{Binding Fondo}" Padding="10,4" Margin="0,0,0,1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Simbolo}"
                               Foreground="{Binding Color}"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Hora}"
                               Style="{StaticResource TxMono}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Entrada}"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Detalle}"
                               Foreground="{Binding Color}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Duracion}"
                               Style="{StaticResource TxMono}" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,20,26,28">
        <StackPanel MaxWidth="660" HorizontalAlignment="Left">

            <!-- Cabecera -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Anillo girando mientras hay trabajo -->
                <Grid Grid.Column="0" Width="17" Height="17" VerticalAlignment="Top" Margin="0,4,0,0"
                      Visibility="{Binding VisibilidadEnMarcha}">
                    <Ellipse Stroke="{StaticResource RepBrush}" StrokeThickness="2"
                             StrokeDashArray="3.2 2.2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnMarcha}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Giro">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.85" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Giro" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxH2}" />
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TxBodyMuted}" Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource BtnSecondary}"
                        Visibility="{Binding VisibilidadEnMarcha}"
                        Content="Cancelar" VerticalAlignment="Top"
                        Click="Cancelar_Click" />
            </Grid>

            <!-- ============================================================
                 PROGRESO
                 ============================================================ -->
            <Border Margin="0,18,0,0" Padding="16"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EntradaActual}"
                                   Style="{StaticResource TxMono}" FontSize="12"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Contador}"
                                   FontSize="21" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Barra -->
                    <Border Margin="0,10,0,0" Height="6" CornerRadius="3"
                            Background="{StaticResource HairBrush}">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="BarraProgreso"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RepMarkBrush}"
                                    CornerRadius="3" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5">
                            <Run Text="Transcurrido" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding Transcurrido}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5" Margin="18,0,0,0">
                            <Run Text="Quedan" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding Restante}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5" Margin="18,0,0,0">
                            <Run Text="Registros" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding RegistrosTexto}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Tira: una celda por entrada -->
                    <ctl:TiraEstados Height="16" Margin="0,14,0,0"
                                     Estados="{Binding Estados}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource RepMarkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Con datos" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource UatMarkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Sin datos" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BadBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Error" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource HairBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Pendiente" Style="{StaticResource TxHelp}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================
                 REGISTRO EN VIVO
                 ============================================================ -->
            <TextBlock Text="REGISTRO" Style="{StaticResource TxSection}" Margin="0,20,0,8" />
            <Border CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1"
                    Padding="8">
                <ItemsControl ItemsSource="{Binding Registro}"
                              ItemTemplate="{StaticResource PlantillaLinea}" />
            </Border>

            <!-- ============================================================
                 RESULTADO
                 ============================================================ -->
            <Border Visibility="{Binding VisibilidadResultado}"
                    Margin="0,20,0,0" Padding="16"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding ResumenTitulo}"
                               Foreground="{Binding ColorResumen}"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResumenDetalle}"
                               Style="{StaticResource TxMono}" FontSize="11.5" Margin="0,4,0,0" />

                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Total}" FontSize="19" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Procesados" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResConDatos}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource OkBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Con datos" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResSinDatos}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink4Brush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Sin datos" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ResErrores}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{Binding ColorResumen}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Con error" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Terminó sin tocar nada: se dice por qué y que no hay nada que deshacer -->
                    <Border Visibility="{Binding VisibilidadSinCambios}"
                            Margin="0,14,0,0" Padding="12,10"
                            CornerRadius="{StaticResource RCtl}"
                            Background="{StaticResource SunkBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                                <Ellipse Stroke="{StaticResource Ink4Brush}" StrokeThickness="1.5" />
                                <Path Data="M 8,7.2 L 8,11.2"
                                      Stroke="{StaticResource Ink4Brush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource Ink4Brush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding ExplicacionSinCambios}"
                                       Style="{StaticResource TxHelp}"
                                       HorizontalAlignment="Left"
                                       MaxWidth="520" />
                        </StackPanel>
                    </Border>

                    <!-- Fallidas: lo que permite relanzar solo eso -->
                    <Border Visibility="{Binding VisibilidadFallidas}"
                            Margin="0,14,0,0" Padding="12,10"
                            CornerRadius="{StaticResource RCtl}"
                            Background="{StaticResource BadSoftBrush}"
                            BorderBrush="{StaticResource BadLineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Estas entradas fallaron" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TextoFallidas}"
                                           Style="{StaticResource TxMono}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                    Content="Reintentar solo esas"
                                    VerticalAlignment="Center"
                                    Click="Reintentar_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource BtnSecondary}"
                                Content="Volver al formulario"
                                Click="Volver_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
