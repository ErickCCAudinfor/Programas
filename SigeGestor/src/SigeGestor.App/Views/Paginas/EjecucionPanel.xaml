<UserControl x:Class="SigeGestor.App.Views.Paginas.EjecucionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SigeGestor.App.Controles"
             FontFamily="{StaticResource FontUi}"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>
        <!-- Fila del registro en vivo -->
        <DataTemplate x:Key="PlantillaLinea">
            <!--
                El motivo llevaba 96 px fijos y salía cortado: «sin PDF en la...». Ahora la
                columna es proporcional y se lleva más sitio que la entrada, porque cuando algo
                va mal el motivo es lo que hay que leer. Y toda la fila muestra entrada y
                motivo completos al pasar por encima, que es la salida para los largos.
            -->
            <Border Background="{Binding Fondo}" Padding="10,4" Margin="0,0,0,1" CornerRadius="3"
                    ToolTipService.ShowDuration="30000">
                <Border.ToolTip>
                    <ToolTip MaxWidth="520">
                        <StackPanel>
                            <TextBlock Text="{Binding Entrada, Mode=OneWay}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding Detalle, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="1.1*" MinWidth="120" />
                        <ColumnDefinition Width="2*" MinWidth="150" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Simbolo}"
                               Foreground="{Binding Color}"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Hora}"
                               Style="{StaticResource TxMono}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Entrada}"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Detalle}"
                               Foreground="{Binding Color}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               Margin="10,0,8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Duracion}"
                               Style="{StaticResource TxMono}" FontSize="11"
                               TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="26,20,26,28">
        <StackPanel MaxWidth="660" HorizontalAlignment="Left">

            <!-- Cabecera -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Anillo girando mientras hay trabajo -->
                <Grid Grid.Column="0" Width="17" Height="17" VerticalAlignment="Top" Margin="0,4,0,0"
                      Visibility="{Binding VisibilidadEnMarcha}">
                    <Ellipse Stroke="{StaticResource RepBrush}" StrokeThickness="2"
                             StrokeDashArray="3.2 2.2" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EnMarcha}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Giro">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.85" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Giro" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,16,0">
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TxH2}" />
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TxBodyMuted}" Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource BtnSecondary}"
                        Visibility="{Binding VisibilidadEnMarcha}"
                        Content="Cancelar" VerticalAlignment="Top"
                        Click="Cancelar_Click" />
            </Grid>

            <!-- ============================================================
                 PROGRESO
                 ============================================================ -->
            <Border Margin="0,18,0,0" Padding="16"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--
                            Aquí SÍ se recorta con puntos suspensivos, a diferencia del resumen:
                            esta línea cambia en cada entrada y si se ajustase el texto la
                            barra de progreso saltaría arriba y abajo mientras corre. El texto
                            entero queda en el ToolTip.
                        -->
                        <TextBlock Grid.Column="0" Text="{Binding EntradaActual}"
                                   Style="{StaticResource TxMono}" FontSize="12"
                                   VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding EntradaActual}" />
                        <TextBlock Grid.Column="1" Text="{Binding Contador}"
                                   FontSize="21" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Barra -->
                    <Border Margin="0,10,0,0" Height="6" CornerRadius="3"
                            Background="{StaticResource HairBrush}">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="BarraProgreso"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource RepMarkBrush}"
                                    CornerRadius="3" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5">
                            <Run Text="Transcurrido" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding Transcurrido}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5" Margin="18,0,0,0">
                            <Run Text="Quedan" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding Restante}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource TxMono}" FontSize="11.5" Margin="18,0,0,0">
                            <Run Text="Registros" Foreground="{StaticResource Ink4Brush}" />
                            <Run Text="{Binding RegistrosTexto}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Tira: una celda por entrada -->
                    <ctl:TiraEstados Height="16" Margin="0,14,0,0"
                                     Estados="{Binding Estados}" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource RepMarkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Con datos" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource UatMarkBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Sin datos" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BadBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Error" Style="{StaticResource TxHelp}" Margin="5,0,14,0" VerticalAlignment="Center" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource HairBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Pendiente" Style="{StaticResource TxHelp}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================
                 REGISTRO EN VIVO
                 ============================================================ -->
            <TextBlock Text="REGISTRO" Style="{StaticResource TxSection}" Margin="0,20,0,8" />
            <!--
                MaxHeight y ScrollViewer propio: antes el ItemsControl crecía sin tope dentro
                del StackPanel de la página, así que con 70 facturas la pantalla entera se
                estiraba y el resumen del final quedaba a un scroll de distancia. Ahora crece
                dentro de su caja.

                Las líneas llegan con la más reciente arriba, así que no hace falta desplazar
                nada solo: lo último siempre se ve.
            -->
            <Border CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1"
                    Padding="8">
                <ScrollViewer MaxHeight="330"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Registro}"
                                  ItemTemplate="{StaticResource PlantillaLinea}" />
                </ScrollViewer>
            </Border>

            <!-- ============================================================
                 RESULTADO
                 ============================================================ -->
            <Border Visibility="{Binding VisibilidadResultado}"
                    Margin="0,20,0,0" Padding="16"
                    CornerRadius="{StaticResource RCard}"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding ResumenTitulo}"
                               Foreground="{Binding ColorResumen}"
                               FontSize="17" FontWeight="SemiBold" />
                    <!-- Se ajusta el texto: sin esto la línea se cortaba en seco contra el
                         borde de la tarjeta, sin puntos suspensivos ni nada, y el final del
                         mensaje simplemente no existía. -->
                    <TextBlock Text="{Binding ResumenDetalle}"
                               Style="{StaticResource TxMono}" FontSize="11.5" Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Total}" FontSize="19" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Procesados" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResConDatos}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource OkBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Con datos" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding ResSinDatos}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink4Brush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Sin datos" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ResErrores}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{Binding ColorResumen}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="Con error" Style="{StaticResource TxHelp}" />
                        </StackPanel>
                    </UniformGrid>

                    <!--
                        DÓNDE HA QUEDADO LO GENERADO.

                        La ruta iba antes dentro del mensaje de resultado, y el mensaje se pinta
                        en tres sitios de una línea —cabecera, registro y resumen— donde se
                        cortaba en los tres. Aquí sale entera, se puede seleccionar con el ratón
                        y hay un botón que abre la carpeta.
                    -->
                    <StackPanel Visibility="{Binding VisibilidadSalidas}" Margin="0,14,0,0">

                        <TextBlock Text="SE HA GUARDADO EN" Style="{StaticResource TxSection}" />

                        <ItemsControl ItemsSource="{Binding Salidas}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="11,9"
                                            CornerRadius="{StaticResource RChip}"
                                            Background="{StaticResource SunkBrush}"
                                            BorderBrush="{StaticResource HairBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                <!--
                                                    TextBox y no TextBlock: así se puede
                                                    seleccionar la ruta con el ratón y copiarla
                                                    a mano.

                                                    Mode=OneWay OBLIGATORIO: Text de TextBox se
                                                    enlaza en dos sentidos por defecto y Carpeta
                                                    es de solo lectura; sin esto WPF lanza
                                                    InvalidOperationException al abrir. Y no
                                                    basta con IsReadOnly, que no cambia el modo.
                                                -->
                                                <TextBox Text="{Binding Carpeta, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         IsReadOnlyCaretVisible="False"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="0"
                                                         TextWrapping="Wrap"
                                                         FontFamily="{StaticResource FontMono}"
                                                         FontSize="11.5"
                                                         Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding Ficheros}"
                                                           Visibility="{Binding VisibilidadFicheros}"
                                                           Style="{StaticResource TxHelp}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Style="{StaticResource BtnSecondary}"
                                                    Content="Abrir carpeta"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}"
                                                    Click="AbrirCarpeta_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- Terminó sin tocar nada: se dice por qué y que no hay nada que deshacer -->
                    <Border Visibility="{Binding VisibilidadSinCambios}"
                            Margin="0,14,0,0" Padding="12,10"
                            CornerRadius="{StaticResource RCtl}"
                            Background="{StaticResource SunkBrush}"
                            BorderBrush="{StaticResource HairBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                                <Ellipse Stroke="{StaticResource Ink4Brush}" StrokeThickness="1.5" />
                                <Path Data="M 8,7.2 L 8,11.2"
                                      Stroke="{StaticResource Ink4Brush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Width="1.8" Height="1.8" Fill="{StaticResource Ink4Brush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding ExplicacionSinCambios}"
                                       Style="{StaticResource TxHelp}"
                                       HorizontalAlignment="Left"
                                       MaxWidth="520" />
                        </StackPanel>
                    </Border>

                    <!--
                        LO QUE NO SALIÓ BIEN.

                        Sustituye al bloque que solo miraba los errores: allí un «sin PDF en la
                        base» no aparecía nunca, porque cuenta como «sin datos» y no como fallo,
                        y era justo lo que había que ver. Aquí entran las dos cosas.

                        El motivo se muestra COMPLETO, que es lo que en el registro no cabía.
                    -->
                    <Border Visibility="{Binding VisibilidadIncidencias}"
                            Margin="0,14,0,0" Padding="12,10"
                            CornerRadius="{StaticResource RCtl}"
                            Background="{StaticResource BadSoftBrush}"
                            BorderBrush="{StaticResource BadLineBrush}"
                            BorderThickness="1">
                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding TituloIncidencias}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnSecondary}"
                                            Content="Copiar las entradas"
                                            ToolTip="Una por línea, para pegarlas de vuelta en el cuadro de la operación"
                                            Click="CopiarEntradas_Click" />
                                    <Button Style="{StaticResource BtnGhost}"
                                            Content="Copiar con el motivo"
                                            Margin="6,0,0,0"
                                            ToolTip="Entrada, estado y motivo separados por tabulador: al pegarlo en Excel cae en columnas"
                                            Click="CopiarConMotivo_Click" />
                                </StackPanel>
                            </Grid>

                            <!-- Las primeras, con su motivo entero -->
                            <Border Margin="0,10,0,0" Padding="10,8"
                                    CornerRadius="{StaticResource RChip}"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BadLineBrush}"
                                    BorderThickness="1">
                                <ScrollViewer MaxHeight="190"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DetalleIncidencias}"
                                               Style="{StaticResource TxMono}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource InkBrush}" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="{Binding RestoIncidencias}"
                                       Visibility="{Binding VisibilidadRestoIncidencias}"
                                       Style="{StaticResource TxHelp}"
                                       HorizontalAlignment="Left"
                                       Margin="0,7,0,0" />

                            <TextBlock Text="{Binding AvisoCopiado}"
                                       Visibility="{Binding VisibilidadAvisoCopiado}"
                                       Foreground="{StaticResource OkBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,7,0,0" />

                            <!-- Reintentar solo tiene sentido con los errores: un «sin PDF en
                                 la base» no cambia por volver a pedirlo. -->
                            <Button Visibility="{Binding VisibilidadFallidas}"
                                    Style="{StaticResource BtnSecondary}"
                                    Content="Reintentar solo las que dieron error"
                                    HorizontalAlignment="Left"
                                    Margin="0,11,0,0"
                                    Click="Reintentar_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource BtnSecondary}"
                                Content="Volver al formulario"
                                Click="Volver_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
