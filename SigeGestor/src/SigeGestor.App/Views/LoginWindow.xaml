<Window x:Class="SigeGestor.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SigeGestor.App.Converters"
        Title="SigeGestor"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        MouseLeftButtonDown="Ventana_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolAVis" />
        <conv:BoolNegadoConverter x:Key="NoBool" />
    </Window.Resources>

    <!-- Margen exterior para que quepa la sombra -->
    <Grid Margin="18">
        <!--
            El filo de tinta se hace con dos bordes anidados en vez de una tira de 3px:
            un radio de 13 sobre un alto de 3 se come la geometría entera y no se dibuja
            nada. Así además el filo sigue la curva de la esquina.
        -->
        <Border Background="{StaticResource MarcaDegradado}"
                CornerRadius="{StaticResource RWin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="6" Direction="270"
                                  Color="#0B0C0E" Opacity="0.16" />
            </Border.Effect>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="12,12,13,13"
                    Margin="0,3,0,0"
                    SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barra de título propia -->
                <Grid Grid.Row="0">
                    <Button Style="{StaticResource BtnIcon}"
                            HorizontalAlignment="Right"
                            Margin="0,8,8,0"
                            IsTabStop="False"
                            ToolTip="Cerrar"
                            Click="Cerrar_Click">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9"
                              Stroke="{StaticResource Ink3Brush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <!-- Cuerpo -->
                <StackPanel Grid.Row="1" Margin="34,14,34,30">

                    <!-- Marca -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                        <Border Width="42" Height="42" CornerRadius="10"
                                Background="{StaticResource MarcaDegradado}">
                            <Path Data="M 4.6,11.6 L 4.6,7 M 8,11.6 L 8,4.4 M 11.4,11.6 L 11.4,9"
                                  Stroke="{StaticResource OnInkBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Gestor de Datos SIGE" Style="{StaticResource TxH2}" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource TxMono}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Usuario -->
                    <TextBlock Text="Usuario" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="CajaUsuario"
                             Style="{StaticResource InputBase}"
                             Tag="Tu usuario de SIGE"
                             Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Validando, Converter={StaticResource NoBool}}"
                             TabIndex="0" />

                    <!-- Clave, con alternancia entre oculta y visible -->
                    <TextBlock Text="Clave" Style="{StaticResource TxLabel}" Margin="0,16,0,6" />
                    <Grid>
                        <PasswordBox x:Name="CajaClave"
                                     Style="{StaticResource PasswordBase}"
                                     Padding="11,0,40,0"
                                     TabIndex="1"
                                     IsEnabled="{Binding Validando, Converter={StaticResource NoBool}}"
                                     PasswordChanged="CajaClave_PasswordChanged" />
                        <TextBox x:Name="CajaClaveVisible"
                                 Style="{StaticResource InputBase}"
                                 Padding="11,0,40,0"
                                 TabIndex="1"
                                 Visibility="Collapsed"
                                 IsEnabled="{Binding Validando, Converter={StaticResource NoBool}}"
                                 TextChanged="CajaClaveVisible_TextChanged" />
                        <Button Style="{StaticResource BtnIcon}"
                                HorizontalAlignment="Right"
                                Margin="0,0,3,0"
                                IsTabStop="False"
                                ToolTip="Ver la clave"
                                Click="VerClave_Click">
                            <Grid Width="16" Height="16">
                                <Path Data="M 1.4,8 C 3.4,4.6 5.5,4.2 8,4.2 C 10.5,4.2 12.6,4.6 14.6,8 C 12.6,11.4 10.5,11.8 8,11.8 C 5.5,11.8 3.4,11.4 1.4,8 Z"
                                      Stroke="{StaticResource Ink3Brush}"
                                      StrokeThickness="1.3"
                                      StrokeLineJoin="Round" />
                                <Ellipse Width="3.6" Height="3.6"
                                         Stroke="{StaticResource Ink3Brush}"
                                         StrokeThickness="1.3"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Line x:Name="TachonOjo"
                                      X1="2.5" Y1="13.5" X2="13.5" Y2="2.5"
                                      Stroke="{StaticResource Ink3Brush}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Error -->
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            CornerRadius="{StaticResource RCtl}"
                            Background="{StaticResource BadSoftBrush}"
                            BorderBrush="{StaticResource BadLineBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HayError, Converter={StaticResource BoolAVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                                    <Ellipse Stroke="{StaticResource BadBrush}" StrokeThickness="1.5" />
                                    <Path Data="M 8,4.8 L 8,8.8"
                                          Stroke="{StaticResource BadBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Ellipse Width="1.8" Height="1.8"
                                             Fill="{StaticResource BadBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,2.6" />
                                </Grid>
                                <TextBlock Text="{Binding MensajeError}"
                                           Style="{StaticResource TxError}"
                                           MaxWidth="266" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TxHelp}"
                                       Margin="26,6,0,0"
                                       Text="Revisa Config\Entornos.json junto al ejecutable."
                                       Visibility="{Binding ErrorDeConfiguracion, Converter={StaticResource BoolAVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Entrar -->
                    <Button Style="{StaticResource BtnPrimary}"
                            Height="38"
                            Margin="0,20,0,0"
                            IsDefault="True"
                            TabIndex="2"
                            IsEnabled="{Binding Validando, Converter={StaticResource NoBool}}"
                            Click="Entrar_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="15" Height="15" Margin="0,0,9,0"
                                  Visibility="{Binding Validando, Converter={StaticResource BoolAVis}}">
                                <Ellipse Stroke="{StaticResource OnInkBrush}"
                                         StrokeThickness="2"
                                         StrokeDashArray="3.2 2.2"
                                         Opacity="0.92"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Validando}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SbGiro">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                    From="0" To="360" Duration="0:0:0.85" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SbGiro" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding TextoBoton}" />
                        </StackPanel>
                    </Button>

                    <!-- Pie -->
                    <TextBlock Text="Grupo Audinfor - Erick Cupuerán"
                               Style="{StaticResource TxHelp}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />
                </StackPanel>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
