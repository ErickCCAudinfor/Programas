<Window x:Class="SigeGestor.App.Views.Dialogos.EditarModeloWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modelo de impresión"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Padding="24">
        <StackPanel>

            <TextBlock x:Name="Titulo" Text="Nuevo modelo" Style="{StaticResource TxH2}" />
            <TextBlock x:Name="Subtitulo"
                       Style="{StaticResource TxHelp}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="490"
                       Margin="0,6,0,0" />

            <TextBlock Text="Descripción" Style="{StaticResource TxLabel}" Margin="0,20,0,6" />
            <TextBox x:Name="CajaDescripcion" Style="{StaticResource InputBase}"
                     MaxLength="250" TextChanged="Revisar" />

            <Grid Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Entorno" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="CajaEntorno" Height="34" FontSize="13.5"
                              SelectionChanged="Revisar">
                        <ComboBoxItem Content="Luz (G1)" Tag="G1" />
                        <ComboBoxItem Content="Gas (G2)" Tag="G2" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tipo" Style="{StaticResource TxLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="CajaTipo" Height="34" FontSize="13.5"
                              DisplayMemberPath="Nombre"
                              SelectionChanged="Revisar" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Clase (ClassName)" Style="{StaticResource TxLabel}" Margin="0,13,0,6" />
            <TextBox x:Name="CajaClase" Style="{StaticResource InputBase}"
                     MaxLength="250" TextChanged="Revisar" />

            <!-- El .rpt -->
            <TextBlock Text="Report (.rpt)" Style="{StaticResource TxLabel}" Margin="0,16,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CajaReport" Grid.Column="0" Style="{StaticResource InputBase}"
                         IsReadOnly="True" />
                <Button Grid.Column="1" Style="{StaticResource BtnSecondary}"
                        Content="Elegir…" Margin="8,0,0,0"
                        Click="ElegirReport_Click" />
            </Grid>
            <TextBlock x:Name="AvisoReport"
                       Style="{StaticResource TxHelp}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="490"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       Text="Si no eliges fichero se conserva el report que ya tiene el modelo." />

            <TextBlock x:Name="TextoProblema"
                       Style="{StaticResource TxError}"
                       HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="490"
                       Visibility="Collapsed"
                       Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource BtnGhost}" Content="Cancelar"
                        MinWidth="96" Click="Cancelar_Click" IsCancel="True" />
                <Button x:Name="BotonGuardar" Style="{StaticResource BtnPrimary}"
                        Content="Guardar" MinWidth="110" Margin="9,0,0,0"
                        Click="Guardar_Click" IsDefault="True" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
