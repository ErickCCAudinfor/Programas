<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SigeGestor.Core</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="PDFsharp" Version="6.2.3" />
  </ItemGroup>


  <!-- Import de proyecto que el vbproj de ActualizaPrecios tenía: el código portado
       usa DataTable y DataSet sin cualificar. -->
  <ItemGroup>
    <Import Include="System.Data" />
  </ItemGroup>

</Project>
